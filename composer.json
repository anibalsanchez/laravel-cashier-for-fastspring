{
  "name": "anibalsanchez/laravel-cashier-for-fastspring",
  "description": "Cashier For Fastspring is a cashier-like laravel package which provides an interface to Fastspring subscription and payment services.",
  "keywords": [
    "laravel",
    "fastspring",
    "billing",
    "cashier"
  ],
  "license": "MIT",
  "support": {
    "issues": "https://github.com/anibalsanchez/laravel-cashier-for-fastspring/issues",
    "source": "https://github.com/anibalsanchez/laravel-cashier-for-fastspring"
  },
  "authors": [
    {
      "name": "Anibal Sanchez",
      "email": "anibal.sanchez@photalika.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/database": "^12.0",
    "illuminate/support": "^12.0",
    "nesbot/carbon": "^3.0",
    "symfony/http-kernel": "^7.0",
    "guzzlehttp/guzzle": "^7.2",
    "moneyphp/money": "^4.0"
  },
  "require-dev": {
    "php": "^8.3",
    "illuminate/http": "^12.0",
    "illuminate/routing": "^12.0",
    "mockery/mockery": "^1.0",
    "phpunit/phpunit": "^12.0",
    "vlucas/phpdotenv": "^5.6",
    "orchestra/testbench": "^10.0",
    "laravel/pint": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "Photalika\\CashierForFastspring\\": "src/"
    }
  },
  "autoload-dev": {
    "files": [
      "tests/helpers.php"
    ],
    "psr-4": {
      "Photalika\\CashierForFastspring\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Photalika\\CashierForFastspring\\CashierServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html=coverage"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}